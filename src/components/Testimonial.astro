---
// Témoignage client — citation verbatim (on coupe, on ne reformule pas).
// Utilisé sur la home (extrait) et /projets/mymicronutrition (3 paragraphes).
// CSS 100 % tokens. Le JSON-LD Review est porté par la page, pas par ce composant.
interface Props {
  paragraphs: string[];
  author: string;
  role: string;
  sourceUrl: string;
  sourceLabel?: string;
}
const { paragraphs, author, role, sourceUrl, sourceLabel = 'Voir la recommandation sur LinkedIn' } = Astro.props;
---
<figure class="testi reveal">
  <blockquote class="testi-quote">
    {paragraphs.map((p) => <p>{p}</p>)}
  </blockquote>
  <figcaption class="testi-attr">
    <span class="testi-author">{author}</span>
    <span class="testi-role">{role}</span>
    <a href={sourceUrl} target="_blank" rel="noopener" class="testi-link">{sourceLabel} →</a>
  </figcaption>
</figure>

<style>
  .testi {
    max-width: 760px;
    margin: 0 auto;
    background: var(--color-surface-warm);
    border: 1px solid var(--color-border);
    border-left: 3px solid var(--color-primary);
    border-radius: 14px;
    padding: 32px 36px;
  }
  .testi-quote { margin: 0; }
  .testi-quote p {
    font-family: var(--font-serif);
    font-size: 20px;
    line-height: 1.55;
    letter-spacing: -0.01em;
    color: var(--color-text-primary);
    margin: 0 0 14px;
  }
  .testi-quote p:last-child { margin-bottom: 0; }
  .testi-attr {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: 24px;
    padding-top: 18px;
    border-top: 1px solid var(--color-border);
  }
  .testi-author {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 600;
    color: var(--color-text-primary);
  }
  .testi-role {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-text-muted);
  }
  .testi-link {
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 500;
    color: var(--color-accent-cta);
    text-decoration: none;
    margin-top: 10px;
    transition: color 150ms;
  }
  .testi-link:hover { color: var(--color-accent-cta-hover); }
  @media (max-width: 767px) {
    .testi { padding: 24px 22px; }
    .testi-quote p { font-size: 17px; }
  }
</style>
