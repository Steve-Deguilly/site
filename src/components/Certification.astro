---
// Bloc certification : signal secondaire, posé en bas de « Domaines d'intervention ».
// Faits verrouillés : intitulé officiel Anthropic, badge Credly vérifiable.
// Le tiret de « Architect – Foundations » est un demi-cadratin : c'est l'intitulé officiel.
const badgeUrl = 'https://www.credly.com/badges/a293ac29-a4a2-4f9b-95c8-4e3efc961c39';
---
<div class="certif">
  <picture>
    <source srcset="/badge-claude-certified-architect-160.webp" type="image/webp" />
    <img
      class="certif-badge"
      src="/badge-claude-certified-architect-160.png"
      alt="Badge Anthropic Claude Certified Architect – Foundations"
      width="160"
      height="160"
      loading="lazy"
      decoding="async"
    />
  </picture>
  <div class="certif-text">
    <p class="certif-title">Claude Certified Architect – Foundations</p>
    <p class="certif-meta">
      Certification Anthropic, 2026. <a href={badgeUrl} target="_blank" rel="noopener">Vérifiable sur Credly</a>.
    </p>
  </div>
</div>

<style>
  .certif {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 40px;
    padding-top: 24px;
    border-top: 1px solid var(--color-border);
  }
  .certif-badge {
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    display: block;
  }
  .certif-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .certif-title {
    font-family: var(--font-sans);
    font-size: 14px;
    font-weight: 600;
    color: var(--color-text-primary);
    line-height: 1.4;
    margin: 0;
  }
  .certif-meta {
    font-family: var(--font-sans);
    font-size: 13px;
    color: var(--color-text-muted);
    line-height: 1.5;
    margin: 0;
  }
  .certif-meta a {
    color: var(--color-text-muted);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .certif-meta a:hover {
    color: var(--color-primary);
  }
  @media (max-width: 767px) {
    .certif { gap: 14px; }
    .certif-badge { width: 48px; height: 48px; }
  }
</style>
