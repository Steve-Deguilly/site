function loadProgress() {
  try {
    return JSON.parse(localStorage.getItem('ccarf_progress')) || {};
  } catch (e) { return {}; }
}
function saveProgress(p) {
  localStorage.setItem('ccarf_progress', JSON.stringify(p));
}

function fmtTime(sec) {
  const m = Math.floor(sec / 60);
  const s = sec % 60;
  return m + 'm ' + String(s).padStart(2, '0') + 's';
}

function shuffleArray(arr) {
  const a = arr.slice();
  for (let i = a.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [a[i], a[j]] = [a[j], a[i]];
  }
  return a;
}

function shuffleQuestionSet(questions) {
  const withShuffledOptions = questions.map(q => {
    const optionOrder = shuffleArray(q.options.map((_, i) => i));
    const newOptions = optionOrder.map(i => q.options[i]);
    const newCorrect = Array.isArray(q.correct)
      ? q.correct.map(c => optionOrder.indexOf(c)).sort((a, b) => a - b)
      : optionOrder.indexOf(q.correct);
    return Object.assign({}, q, { options: newOptions, correct: newCorrect });
  });
  return shuffleArray(withShuffledOptions);
}

const EXAM_SIZE = 60;
const EXAM_DURATION_MS = 120 * 60 * 1000;
/* Official blueprint weights (27/18/20/20/15%) applied to 60 items */
const EXAM_DOMAIN_TARGETS = [16, 11, 12, 12, 9];

function buildExamSet() {
  let set = [];
  DOMAINS.forEach((_, d) => {
    const pool = shuffleArray(QUESTIONS.filter(q => q.domain === d));
    set = set.concat(pool.slice(0, Math.min(EXAM_DOMAIN_TARGETS[d], pool.length)));
  });
  return shuffleQuestionSet(set);
}

function isAnswerCorrect(q, ans) {
  if (Array.isArray(q.correct)) {
    if (!Array.isArray(ans) || ans.length !== q.correct.length) return false;
    const s = ans.slice().sort((a, b) => a - b);
    return s.every((v, i) => v === q.correct[i]);
  }
  return ans === q.correct;
}

function isOptionCorrect(q, oi) {
  return Array.isArray(q.correct) ? q.correct.includes(oi) : oi === q.correct;
}

function isOptionSelected(sel, oi) {
  return Array.isArray(sel) ? sel.includes(oi) : sel === oi;
}

function switchTab(tab) {
  document.getElementById('tab-btn-exam').classList.toggle('active', tab === 'exam');
  document.getElementById('tab-btn-training').classList.toggle('active', tab === 'training');
  document.getElementById('tab-exam').classList.toggle('active', tab === 'exam');
  document.getElementById('tab-training').classList.toggle('active', tab === 'training');
}

/* ---------------- EXAM TAB ---------------- */

let examState = {
  screen: 'start',
  current: 0,
  questions: [],
  answers: [],
  startTime: null,
  timerHandle: null,
  reviewOpen: false
};

function examDomainCounts() {
  const counts = DOMAINS.map(() => 0);
  QUESTIONS.forEach(q => counts[q.domain]++);
  return counts;
}

function examStart() {
  examState.screen = 'quiz';
  examState.current = 0;
  examState.questions = buildExamSet();
  examState.answers = new Array(examState.questions.length).fill(null);
  examState.startTime = Date.now();
  examState.deadline = Date.now() + EXAM_DURATION_MS;
  renderExam();
  if (examState.timerHandle) clearInterval(examState.timerHandle);
  examState.timerHandle = setInterval(examUpdateTimer, 1000);
}

function examUpdateTimer() {
  const remaining = Math.max(0, Math.ceil((examState.deadline - Date.now()) / 1000));
  const el = document.getElementById('exam-elapsed-timer');
  if (el) {
    el.textContent = fmtTime(remaining) + ' left';
    el.style.color = remaining < 600 ? '#c0392b' : '#6b6b66';
  }
  if (remaining <= 0 && examState.screen === 'quiz') examFinish();
}

function examSelectOption(qIndex, optIndex) {
  const q = examState.questions[qIndex];
  if (Array.isArray(q.correct)) {
    let cur = Array.isArray(examState.answers[qIndex]) ? examState.answers[qIndex].slice() : [];
    const pos = cur.indexOf(optIndex);
    if (pos >= 0) cur.splice(pos, 1);
    else {
      if (cur.length >= q.correct.length) cur.shift();
      cur.push(optIndex);
    }
    examState.answers[qIndex] = cur.length ? cur : null;
  } else {
    examState.answers[qIndex] = optIndex;
  }
  renderExam();
}

function examGoNext() {
  if (examState.current < examState.questions.length - 1) {
    examState.current++;
    renderExam();
  } else {
    examFinish();
  }
}

function examGoPrev() {
  if (examState.current > 0) {
    examState.current--;
    renderExam();
  }
}

function examFinish() {
  examState.screen = 'results';
  if (examState.timerHandle) clearInterval(examState.timerHandle);
  examState.finalElapsed = Math.floor((Date.now() - examState.startTime) / 1000);

  let correct = 0;
  examState.questions.forEach((q, i) => { if (isAnswerCorrect(q, examState.answers[i])) correct++; });
  const progress = loadProgress();
  if (!progress.examBest || correct > progress.examBest.score) {
    progress.examBest = { score: correct, total: examState.questions.length, time: examState.finalElapsed, date: new Date().toISOString().slice(0,10) };
    saveProgress(progress);
  }
  renderExam();
}

function examToggleReview() {
  examState.reviewOpen = !examState.reviewOpen;
  renderExam();
}

function examRestart() {
  examState = { screen: 'start', current: 0, questions: [], answers: [], startTime: null, timerHandle: null, reviewOpen: false };
  renderExam();
}

function renderExamStart() {
  const counts = examDomainCounts();
  const progress = loadProgress();
  const bestHtml = progress.examBest
    ? `<p class="score-pill" style="display:inline-block; margin-bottom:14px;">Best so far: ${progress.examBest.score}/${progress.examBest.total} · ${fmtTime(progress.examBest.time)} · ${progress.examBest.date}</p>`
    : '';
  const rows = DOMAINS.map((d, i) => `
    <div class="domain-row">
      <span class="domain-name">${d}</span>
      <span class="domain-meta">${counts[i]} questions</span>
    </div>`).join('');
  return `
    <div class="card">
      ${bestHtml}
      <div class="stat-row">
        <div class="stat"><p class="stat-label">Questions</p><p class="stat-value">${EXAM_SIZE} / ${QUESTIONS.length}</p></div>
        <div class="stat"><p class="stat-label">Time limit</p><p class="stat-value">120 min</p></div>
      </div>
      <p style="font-size:12px; color:#6b6b66; margin:0 0 12px;">Each run draws ${EXAM_SIZE} questions from the ${QUESTIONS.length}-question bank at the official blueprint weights (27/18/20/20/15%). Includes multiple-response items — each states how many answers to select. The exam auto-submits when the 120-minute countdown reaches zero. Bank size per domain:</p>
      ${rows}
      <button class="primary" onclick="examStart()">Start exam</button>
    </div>`;
}

function renderExamQuestion() {
  const q = examState.questions[examState.current];
  const selected = examState.answers[examState.current];
  const progress = ((examState.current + 1) / examState.questions.length) * 100;
  const options = q.options.map((opt, i) => {
    const isSel = isOptionSelected(selected, i);
    return `
      <div class="option ${isSel ? 'selected' : ''}" onclick="examSelectOption(${examState.current}, ${i})">
        <span class="option-dot"></span>
        <span>${opt}</span>
      </div>`;
  }).join('');
  return `
    <div class="card">
      <div class="meta-row">
        <span>Question ${examState.current + 1} of ${examState.questions.length}</span>
        <span id="exam-elapsed-timer">120m 00s left</span>
      </div>
      <div class="progress-track"><div class="progress-fill" style="width:${progress}%;"></div></div>
      <p class="domain-tag">${DOMAINS[q.domain]}</p>
      ${Array.isArray(q.correct) ? `<p class="multi-note">Multiple response — select ${q.correct.length} answers.</p>` : ''}
      <p class="q-text">${q.q}</p>
      ${options}
      <div class="nav-row">
        <button class="secondary" onclick="examGoPrev()" ${examState.current === 0 ? 'disabled' : ''}>Previous</button>
        <button class="primary" style="width:auto; margin-top:0;" onclick="examGoNext()" ${(Array.isArray(q.correct) ? (Array.isArray(selected) && selected.length === q.correct.length) : selected !== null) ? '' : 'disabled'}>${examState.current === examState.questions.length - 1 ? 'Finish exam' : 'Next question'}</button>
      </div>
    </div>`;
}

function renderExamResults() {
  let correct = 0;
  const domainTotals = DOMAINS.map(() => 0);
  examState.questions.forEach(q => domainTotals[q.domain]++);
  const domainCorrect = DOMAINS.map(() => 0);
  examState.questions.forEach((q, i) => {
    if (isAnswerCorrect(q, examState.answers[i])) { correct++; domainCorrect[q.domain]++; }
  });
  const pct = Math.round((correct / examState.questions.length) * 100);

  const domainRows = DOMAINS.map((d, i) => {
    const dPct = Math.round((domainCorrect[i] / domainTotals[i]) * 100);
    return `
      <div class="bar-row">
        <div class="bar-labels"><span style="color:#6b6b66;">${d}</span><span style="font-weight:500;">${domainCorrect[i]}/${domainTotals[i]}</span></div>
        <div class="bar-track"><div class="bar-fill" style="width:${dPct}%;"></div></div>
      </div>`;
  }).join('');

  let reviewHtml = '';
  if (examState.reviewOpen) {
    reviewHtml = examState.questions.map((q, i) => {
      const userAns = examState.answers[i];
      const isCorrect = isAnswerCorrect(q, userAns);
      const optsHtml = q.options.map((opt, oi) => {
        let cls = 'neutral';
        let prefix = '';
        if (isOptionCorrect(q, oi)) { cls = 'correct'; prefix = '✓ '; }
        else if (isOptionSelected(userAns, oi)) { cls = 'wrong'; prefix = '✗ '; }
        return `<div class="review-opt ${cls}">${prefix}${opt}</div>`;
      }).join('');
      return `
        <div class="review-item">
          <p class="review-q-meta">Question ${i + 1} — ${DOMAINS[q.domain]} ${isCorrect ? '' : '· missed'}</p>
          <p class="review-q-text">${q.q}</p>
          ${optsHtml}
          <p class="review-rationale">${q.rationale}</p>
        </div>`;
    }).join('');
  }

  return `
    <div class="card">
      <div class="stat-row">
        <div class="stat"><p class="stat-label">Score</p><p class="stat-value">${correct} / ${examState.questions.length} (${pct}%)</p></div>
        <div class="stat"><p class="stat-label">Time</p><p class="stat-value">${fmtTime(examState.finalElapsed)}</p></div>
      </div>
      <p style="font-size:13px; color:#6b6b66; margin:0 0 8px;">Breakdown by domain</p>
      ${domainRows}
      <div class="nav-row">
        <button class="secondary" onclick="examToggleReview()">${examState.reviewOpen ? 'Hide answers' : 'Show answers'}</button>
        <button class="secondary" onclick="examRestart()">Restart exam</button>
      </div>
      ${reviewHtml}
    </div>`;
}

function renderExam() {
  const root = document.getElementById('tab-exam');
  if (examState.screen === 'start') root.innerHTML = renderExamStart();
  else if (examState.screen === 'quiz') root.innerHTML = renderExamQuestion();
  else root.innerHTML = renderExamResults();
}

/* ---------------- TRAINING TAB ---------------- */

let trainState = {
  screen: 'menu',
  domainIndex: null,
  questions: [],
  current: 0,
  answered: false,
  selected: null,
  correctCount: 0
};

function trainDomainCounts() {
  const counts = DOMAINS.map(() => 0);
  QUESTIONS.forEach(q => counts[q.domain]++);
  return counts;
}

function trainStartDomain(domainIndex) {
  trainState.domainIndex = domainIndex;
  const base = domainIndex === -1 ? QUESTIONS : QUESTIONS.filter(q => q.domain === domainIndex);
  trainState.questions = shuffleQuestionSet(base);
  trainState.current = 0;
  trainState.answered = false;
  trainState.selected = null;
  trainState.correctCount = 0;
  trainState.screen = 'practice';
  renderTraining();
}

function trainBackToMenu() {
  trainState.screen = 'menu';
  renderTraining();
}

function trainSelectOption(optIndex) {
  if (trainState.answered) return;
  const q = trainState.questions[trainState.current];
  if (Array.isArray(q.correct)) {
    let cur = Array.isArray(trainState.selected) ? trainState.selected.slice() : [];
    const pos = cur.indexOf(optIndex);
    if (pos >= 0) cur.splice(pos, 1);
    else {
      if (cur.length >= q.correct.length) cur.shift();
      cur.push(optIndex);
    }
    trainState.selected = cur.length ? cur : null;
    renderTraining();
    return;
  }
  trainState.selected = optIndex;
  trainState.answered = true;
  if (isAnswerCorrect(q, optIndex)) trainState.correctCount++;
  renderTraining();
}

function trainCheckMulti() {
  if (trainState.answered) return;
  const q = trainState.questions[trainState.current];
  if (!Array.isArray(trainState.selected) || trainState.selected.length !== q.correct.length) return;
  trainState.answered = true;
  if (isAnswerCorrect(q, trainState.selected)) trainState.correctCount++;
  renderTraining();
}

function trainNext() {
  if (trainState.current < trainState.questions.length - 1) {
    trainState.current++;
    trainState.answered = false;
    trainState.selected = null;
    renderTraining();
  } else {
    trainState.screen = 'summary';
    if (trainState.domainIndex !== -1) {
      const progress = loadProgress();
      progress.domainBest = progress.domainBest || {};
      const key = String(trainState.domainIndex);
      const pct = trainState.correctCount / trainState.questions.length;
      const prevPct = progress.domainBest[key] ? progress.domainBest[key].score / progress.domainBest[key].total : -1;
      if (pct > prevPct) {
        progress.domainBest[key] = { score: trainState.correctCount, total: trainState.questions.length, date: new Date().toISOString().slice(0,10) };
        saveProgress(progress);
      }
    }
    renderTraining();
  }
}

function renderTrainMenu() {
  const counts = trainDomainCounts();
  const progress = loadProgress();
  const domainBest = progress.domainBest || {};
  const cards = DOMAINS.map((d, i) => {
    const best = domainBest[String(i)];
    const bestHtml = best ? `<span class="best-badge">Best: ${best.score}/${best.total}</span>` : '';
    return `
      <div class="domain-card">
        <div>
          <p class="domain-card-title">${d}</p>
          <p class="domain-card-meta">${counts[i]} questions ${bestHtml ? '· ' + bestHtml : ''}</p>
        </div>
        <button class="secondary" onclick="trainStartDomain(${i})">Practice</button>
      </div>`;
  }).join('');
  return `
    <div class="card">
      <p style="font-size:13px; color:#6b6b66; margin:0 0 14px;">Pick a domain to practice. Each answer is revealed immediately with an explanation — no waiting until the end.</p>
      ${cards}
      <div class="domain-card" style="border-style:dashed;">
        <div>
          <p class="domain-card-title">All domains (mixed)</p>
          <p class="domain-card-meta">${QUESTIONS.length} questions</p>
        </div>
        <button class="secondary" onclick="trainStartDomain(-1)">Practice</button>
      </div>
    </div>`;
}

function renderTrainPractice() {
  const q = trainState.questions[trainState.current];
  const progress = ((trainState.current + 1) / trainState.questions.length) * 100;
  const options = q.options.map((opt, i) => {
    let cls = '';
    if (trainState.answered) {
      cls = 'disabled';
      if (isOptionCorrect(q, i)) cls += ' correct-answer';
      else if (isOptionSelected(trainState.selected, i)) cls += ' wrong-answer';
    } else if (isOptionSelected(trainState.selected, i)) {
      cls = 'selected';
    }
    return `
      <div class="option ${cls}" onclick="trainSelectOption(${i})">
        <span class="option-dot"></span>
        <span>${opt}</span>
      </div>`;
  }).join('');

  let rationaleHtml = '';
  if (trainState.answered) {
    const wasCorrect = isAnswerCorrect(q, trainState.selected);
    rationaleHtml = `
      <div class="rationale-box ${wasCorrect ? 'correct' : 'incorrect'}">
        <p class="rationale-label">${wasCorrect ? 'Correct' : 'Incorrect — correct answer highlighted above'}</p>
        <p style="margin:0;">${q.rationale}</p>
      </div>`;
  }

  const domainLabel = DOMAINS[q.domain] + (q.fromCourse ? ' · from your course notes' : '');

  return `
    <div class="card">
      <div class="meta-row">
        <span>Question ${trainState.current + 1} of ${trainState.questions.length}</span>
        <span class="score-pill">${trainState.correctCount} correct so far</span>
      </div>
      <div class="progress-track"><div class="progress-fill" style="width:${progress}%;"></div></div>
      <p class="domain-tag">${domainLabel}</p>
      ${Array.isArray(q.correct) ? `<p class="multi-note">Multiple response — select ${q.correct.length} answers, then check.</p>` : ''}
      <p class="q-text">${q.q}</p>
      ${options}
      ${Array.isArray(q.correct) && !trainState.answered ? `<button class="primary" style="width:auto; margin-top:4px;" onclick="trainCheckMulti()" ${Array.isArray(trainState.selected) && trainState.selected.length === q.correct.length ? '' : 'disabled'}>Check answer</button>` : ''}
      ${rationaleHtml}
      <div class="nav-row">
        <button class="secondary" onclick="trainBackToMenu()">Back to domains</button>
        <button class="primary" style="width:auto; margin-top:0;" onclick="trainNext()" ${trainState.answered ? '' : 'disabled'}>${trainState.current === trainState.questions.length - 1 ? 'Finish' : 'Next question'}</button>
      </div>
    </div>`;
}

function renderTrainSummary() {
  const pct = Math.round((trainState.correctCount / trainState.questions.length) * 100);
  const label = trainState.domainIndex === -1 ? 'All domains' : DOMAINS[trainState.domainIndex];
  return `
    <div class="card">
      <p style="font-size:13px; color:#6b6b66; margin:0 0 6px;">${label}</p>
      <div class="stat-row">
        <div class="stat"><p class="stat-label">Score</p><p class="stat-value">${trainState.correctCount} / ${trainState.questions.length} (${pct}%)</p></div>
      </div>
      <div class="nav-row">
        <button class="secondary" onclick="trainBackToMenu()">Back to domains</button>
        <button class="primary" style="width:auto; margin-top:0;" onclick="trainStartDomain(trainState.domainIndex)">Practice again</button>
      </div>
    </div>`;
}

function renderTraining() {
  const root = document.getElementById('tab-training');
  if (trainState.screen === 'menu') root.innerHTML = renderTrainMenu();
  else if (trainState.screen === 'practice') root.innerHTML = renderTrainPractice();
  else root.innerHTML = renderTrainSummary();
}

renderExam();
renderTraining();

</script>
</Layout>

<!-- Habillage repris du design system (cream / jade / terracotta, Fraunces / Inter / JetBrains).
     is:global + tout préfixé .ccar : nécessaire car l'UI du quiz est générée en JS (les styles
     scopés Astro ne s'appliqueraient pas aux éléments créés au runtime), sans fuite hors .ccar. -->
<style is:global>
  .ccar {
    --ok: #2F6D4F; --ok-bg: #E7F1EA; --ok-text: #1E4C37;
    --ko: #B23A3A; --ko-bg: #FBEAEA; --ko-text: #822B2B;
    --amber-bg: #F6EFD8; --amber-border: #E4D6A8; --amber-text: #7A621C;
    --sel-bg: rgba(45, 90, 79, 0.10);
    padding: 56px 0 96px;
  }
  @media (max-width: 767px) { .ccar { padding: 36px 0 64px; } }

  .ccar .ccar-title {
    font-family: var(--font-serif);
    font-size: 40px; font-weight: 500; letter-spacing: -0.02em; line-height: 1.06;
    color: var(--color-text-primary); margin: 8px 0 12px;
  }
  @media (max-width: 767px) { .ccar .ccar-title { font-size: 30px; } }
  .ccar .ccar-sub {
    font-family: var(--font-sans); font-size: 15px; line-height: 1.65;
    color: var(--color-text-muted); max-width: 640px; margin: 0 0 32px;
  }

  /* Onglets */
  .ccar .tabs { display: flex; gap: 4px; border-bottom: 1px solid var(--color-border); margin-bottom: 28px; }
  .ccar .tab-btn {
    appearance: none; border: none; background: none; cursor: pointer;
    padding: 10px 16px; font-family: var(--font-sans); font-size: 14px; font-weight: 500;
    color: var(--color-text-muted); border-bottom: 2px solid transparent; margin-bottom: -1px;
    transition: color 150ms, border-color 150ms;
  }
  .ccar .tab-btn.active { color: var(--color-primary); border-bottom-color: var(--color-primary); }
  .ccar .tab-panel { display: none; }
  .ccar .tab-panel.active { display: block; }

  /* Cartes */
  .ccar .card {
    background: var(--color-surface-warm); border: 1px solid var(--color-border);
    border-radius: 14px; padding: 24px;
  }
  .ccar .stat-row { display: flex; gap: 14px; margin-bottom: 16px; }
  .ccar .stat { flex: 1; background: var(--color-bg-cream); border: 1px solid var(--color-border); border-radius: 10px; padding: 14px 16px; }
  .ccar .stat-label { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.03em; text-transform: uppercase; color: var(--color-text-muted); margin: 0 0 6px; }
  .ccar .stat-value { font-family: var(--font-serif); font-size: 24px; font-weight: 500; color: var(--color-primary-deep); margin: 0; }

  .ccar .domain-row { display: flex; justify-content: space-between; align-items: center; padding: 10px 0; border-top: 1px solid var(--color-border); font-size: 14px; }
  .ccar .domain-row:first-of-type { border-top: none; }
  .ccar .domain-name { color: var(--color-text-primary); }
  .ccar .domain-meta { font-family: var(--font-mono); color: var(--color-text-muted); font-size: 12px; }

  /* Boutons */
  .ccar button.primary {
    width: 100%; margin-top: 18px; padding: 12px 18px; border: none; border-radius: 8px;
    background: var(--color-accent-cta); color: #FFFFFF; font-family: var(--font-sans);
    font-size: 14px; font-weight: 600; cursor: pointer; transition: background 150ms;
  }
  .ccar button.primary:hover { background: var(--color-accent-cta-hover); }
  .ccar button.secondary {
    padding: 9px 14px; border: 1px solid var(--color-primary); border-radius: 8px;
    background: transparent; color: var(--color-primary); font-family: var(--font-sans);
    font-size: 13px; font-weight: 500; cursor: pointer; transition: background 150ms, color 150ms;
  }
  .ccar button.secondary:hover { background: var(--color-primary); color: var(--color-bg-cream); }
  .ccar button:disabled { opacity: 0.4; cursor: default; }

  /* Progression / méta */
  .ccar .progress-track { height: 4px; background: var(--color-border); border-radius: 4px; margin-bottom: 16px; overflow: hidden; }
  .ccar .progress-fill { height: 4px; background: var(--color-primary); border-radius: 4px; transition: width 0.2s; }
  .ccar .meta-row { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px; font-family: var(--font-mono); font-size: 12px; color: var(--color-text-muted); }
  .ccar .domain-tag { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.03em; color: var(--color-text-muted); margin: 0 0 8px; }
  .ccar .q-text { font-size: 16px; line-height: 1.6; margin: 0 0 16px; color: var(--color-text-primary); }

  /* Options */
  .ccar .option {
    cursor: pointer; padding: 12px 14px; margin-bottom: 8px; border-radius: 8px;
    border: 1px solid var(--color-border); background: var(--color-bg-cream);
    display: flex; gap: 10px; align-items: flex-start; font-size: 14px; transition: border-color 120ms, background 120ms;
  }
  .ccar .option:hover { border-color: var(--color-primary); }
  .ccar .option-dot { flex-shrink: 0; width: 16px; height: 16px; border-radius: 50%; border: 1.5px solid var(--color-border); margin-top: 2px; }
  .ccar .option.selected { border-color: var(--color-primary); background: var(--sel-bg); }
  .ccar .option.selected .option-dot { border-color: var(--color-primary); background: var(--color-primary); }
  .ccar .option.correct-answer { border-color: var(--ok); background: var(--ok-bg); }
  .ccar .option.correct-answer .option-dot { border-color: var(--ok); background: var(--ok); }
  .ccar .option.wrong-answer { border-color: var(--ko); background: var(--ko-bg); }
  .ccar .option.wrong-answer .option-dot { border-color: var(--ko); background: var(--ko); }
  .ccar .option.disabled { cursor: default; }

  /* Justifications */
  .ccar .rationale-box { margin-top: 10px; padding: 12px 14px; border-radius: 8px; font-size: 13px; line-height: 1.6; }
  .ccar .rationale-box.correct { background: var(--ok-bg); color: var(--ok-text); }
  .ccar .rationale-box.incorrect { background: var(--ko-bg); color: var(--ko-text); }
  .ccar .rationale-label { font-weight: 600; margin: 0 0 4px; }

  .ccar .nav-row { display: flex; justify-content: space-between; margin-top: 18px; }
  .ccar .score-pill { font-family: var(--font-mono); font-size: 12px; font-weight: 500; color: var(--color-text-primary); background: var(--color-bg-cream); border: 1px solid var(--color-border); border-radius: 20px; padding: 4px 12px; }

  /* Domaines (training) */
  .ccar .domain-card { border: 1px solid var(--color-border); border-radius: 10px; padding: 14px 16px; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; background: var(--color-surface-warm); }
  .ccar .domain-card-title { font-size: 14px; font-weight: 500; margin: 0 0 2px; color: var(--color-text-primary); }
  .ccar .domain-card-meta { font-family: var(--font-mono); font-size: 12px; color: var(--color-text-muted); margin: 0; }
  .ccar .best-badge { font-family: var(--font-mono); font-size: 11px; color: var(--ok); font-weight: 500; }

  /* Barres (résultats) */
  .ccar .bar-row { margin-bottom: 10px; }
  .ccar .bar-labels { display: flex; justify-content: space-between; font-size: 13px; margin-bottom: 4px; color: var(--color-text-primary); }
  .ccar .bar-track { height: 6px; background: var(--color-border); border-radius: 4px; }
  .ccar .bar-fill { height: 6px; background: var(--color-primary); border-radius: 4px; }

  /* Revue */
  .ccar .review-item { border-top: 1px solid var(--color-border); padding: 14px 0; }
  .ccar .review-q-meta { font-family: var(--font-mono); font-size: 11px; color: var(--color-text-muted); margin: 0 0 4px; }
  .ccar .review-q-text { font-size: 14px; margin: 0 0 8px; color: var(--color-text-primary); }
  .ccar .review-opt { display: flex; gap: 8px; align-items: flex-start; padding: 3px 0; font-size: 13px; }
  .ccar .review-opt.correct { color: var(--ok); }
  .ccar .review-opt.wrong { color: var(--ko); }
  .ccar .review-opt.neutral { color: var(--color-text-muted); }
  .ccar .review-rationale { font-size: 12px; color: var(--color-text-muted); margin: 8px 0 0; line-height: 1.5; }

  .ccar .empty-hint { font-size: 13px; color: var(--color-text-muted); text-align: center; padding: 20px 0; }
  .ccar .multi-note { display: inline-block; font-family: var(--font-mono); font-size: 12px; font-weight: 500; color: var(--amber-text); background: var(--amber-bg); border: 1px solid var(--amber-border); border-radius: 6px; padding: 2px 8px; margin: 0 0 10px; }
</style>

