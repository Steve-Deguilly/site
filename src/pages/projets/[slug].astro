---
// Page détail d'un cas client : /projets/<slug>. Pré-rendue au build (output static).
// Template dans CasClientDetail.astro. OG : fallback og-projets.jpg en v1 (OG dédiées = suivi).
import Layout from '../../layouts/Layout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
import CasClientDetail from '../../components/CasClientDetail.astro';
import Testimonial from '../../components/Testimonial.astro';
import { casClients } from '../../data/casClients';

export function getStaticPaths() {
  return casClients.map((cas) => ({ params: { slug: cas.slug }, props: { cas } }));
}

const { cas } = Astro.props;
const siteUrl = 'https://steve-deguilly.com';
const pageUrl = `${siteUrl}/projets/${cas.slug}`;

// Description SEO : la promesse héro, tronquée proprement si trop longue.
const description =
  cas.heroPromesse.length > 155 ? `${cas.heroPromesse.slice(0, 152).trimEnd()}…` : cas.heroPromesse;

// Témoignage Pierre Garcia (recommandation LinkedIn 08/07/2026, réutilisation accordée) — MMN uniquement.
// Verbatim, 3 premiers paragraphes. On coupe (4e paragraphe retiré), on ne reformule pas.
const isMMN = cas.slug === 'mymicronutrition';
const pgarciaParagraphs = [
  "Steve, c’est le genre de personne à qui tu décris un besoin à moitié, et qui revient quelques jours plus tard avec l’outil qui tourne.",
  "Je suis médecin. Il a construit la plateforme e-santé sur laquelle je m’appuie : traitement des dossiers automatisé, données de santé gérées sérieusement (conforme HDS). Ce qui me prenait 45 minutes par dossier m’en prend 2. Et quand un truc doit bouger, c’est réglé dans la journée — sans que j’aie à comprendre la technique.",
  "Ce que j’apprécie le plus : il comprend vite, pas de blabla, et on peut compter sur lui. C’est rare de trouver quelqu’un d’aussi carré sur la donnée et avec qui c’est aussi simple de bosser.",
];
const pgarciaReview = {
  '@type': 'Review',
  '@id': `${pageUrl}/#review-pgarcia`,
  itemReviewed: { '@id': `${siteUrl}/#organization` },
  author: {
    '@type': 'Person',
    name: 'Pierre Garcia',
    sameAs: 'https://www.linkedin.com/in/pierre-garcia-918779320/',
  },
  datePublished: '2026-07-08',
  reviewBody: pgarciaParagraphs.join('\n\n'),
};

// JSON-LD GEO : TechArticle + BreadcrumbList (Person/Organization référencés par @id du Layout).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'TechArticle',
      '@id': `${pageUrl}/#article`,
      headline: cas.heroPromesse,
      about: cas.secteur,
      inLanguage: 'fr',
      url: pageUrl,
      author: { '@id': `${siteUrl}/#person` },
      publisher: { '@id': `${siteUrl}/#organization` },
      keywords: cas.stack.join(', '),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${pageUrl}/#breadcrumb`,
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: `${siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Réalisations', item: `${siteUrl}/projets/` },
        { '@type': 'ListItem', position: 3, name: cas.client, item: `${pageUrl}/` },
      ],
    },
    ...(isMMN ? [pgarciaReview] : []),
  ],
};
---
<Layout
  title={`${cas.client} · ${cas.secteur} · Steve Deguilly`}
  description={description}
  canonical={`/projets/${cas.slug}`}
  ogImage="/og-projets.jpg"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(jsonLd)} />

  <Navbar />
  <main>
    <CasClientDetail cas={cas}>
      {isMMN && (
        <Testimonial
          slot="testimonial"
          paragraphs={pgarciaParagraphs}
          author="Pierre Garcia"
          role="médecin, directeur scientifique de myMicroNutrition"
          sourceUrl="https://www.linkedin.com/in/pierre-garcia-918779320/"
          sourceLabel="Lire la recommandation complète sur LinkedIn"
        />
      )}
    </CasClientDetail>
  </main>
  <Footer />
</Layout>
