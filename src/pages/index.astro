---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import PourQui from '../components/PourQui.astro';
import DomainesIntervention from '../components/DomainesIntervention.astro';
import Approche from '../components/Approche.astro';
import CasConcrets from '../components/CasConcrets.astro';
import Testimonial from '../components/Testimonial.astro';
import APropos from '../components/APropos.astro';
import DiagnosticTeaser from '../components/DiagnosticTeaser.astro';
import DemosTeaser from '../components/DemosTeaser.astro';
import CTAFinal from '../components/CTAFinal.astro';
import Footer from '../components/Footer.astro';

const siteUrl = 'https://steve-deguilly.com';
// Témoignage Pierre Garcia — recommandation LinkedIn publique (08/07/2026, réutilisation accordée).
// Verbatim, extrait home. Review sans reviewRating (aucune note donnée : on n'en invente pas).
const pgarciaQuote =
  "Je suis médecin. Il a construit la plateforme e-santé sur laquelle je m’appuie : traitement des dossiers automatisé, données de santé gérées sérieusement (conforme HDS). Ce qui me prenait 45 minutes par dossier m’en prend 2.";
const reviewJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Review',
  '@id': `${siteUrl}/#review-pgarcia`,
  itemReviewed: { '@id': `${siteUrl}/#organization` },
  author: {
    '@type': 'Person',
    name: 'Pierre Garcia',
    sameAs: 'https://www.linkedin.com/in/pierre-garcia-918779320/',
  },
  datePublished: '2026-07-08',
  reviewBody: pgarciaQuote,
};
---
<Layout
  title="Steve Deguilly · Architecte IA & Automatisation freelance"
  description="RAG souverain, n8n, LLMs sécurisés. 18 ans à automatiser les processus métier qui freinent vos équipes. Freelance · Nice, Monaco, Sophia Antipolis."
  canonical="/"
>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(reviewJsonLd)} />
  <Navbar />
  <main>
    <Hero />
    <PourQui />
    <DomainesIntervention />
    <Approche />
    <CasConcrets />
    <section class="section" aria-label="Témoignage client">
      <div class="container">
        <Testimonial
          paragraphs={[pgarciaQuote]}
          author="Pierre Garcia"
          role="médecin, directeur scientifique de myMicroNutrition"
          sourceUrl="https://www.linkedin.com/in/pierre-garcia-918779320/"
        />
      </div>
    </section>
    <APropos />
    <section class="section home-teasers" aria-label="Outils gratuits">
      <div class="container">
        <div class="home-teasers-grid">
          <DiagnosticTeaser />
          <DemosTeaser />
        </div>
      </div>
    </section>
    <CTAFinal />
  </main>
  <Footer />
</Layout>

<style>
  /* Teasers Diagnostic + Démos & POC côte à côte (2 colonnes), empilés en mobile. */
  .home-teasers-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: stretch;
  }
  @media (max-width: 767px) {
    .home-teasers-grid { grid-template-columns: 1fr; gap: 44px; }
  }
</style>
